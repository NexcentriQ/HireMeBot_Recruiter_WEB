# HireMeBot Recruiter Portal — Environment Example
# Copy this to .env.local for local development.

# Backend API base URL (no trailing slash).
# Local SAM default: http://127.0.0.1:3000  (the API allows the browser origin
# http://localhost:5173 only; see README "Google sign-in, registration and approval").
# Leave it EMPTY to call the same origin instead: `npm run dev` then proxies
# /api to http://127.0.0.1:3000, so no CORS is involved.
VITE_API_BASE_URL=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# App mode (choose ONE):
#
# 1) Full mock mode — no backend required, in-memory data, NO real sign-in.
#      VITE_USE_MOCK_API=true
#    Local only. A production build never turns this on by itself: if
#    VITE_USE_MOCK_API is unset there, mock mode is OFF.
#
# 2) Dev integration mode — real local Java/SAM backend using the
#    ALLOW_DEV_RECRUITER_HEADER mechanism. The frontend sends
#    X-Dev-Recruiter-Id instead of a Cognito Bearer token and skips Google
#    sign-in. Dev-only; never sent by a production build.
#      VITE_USE_MOCK_API=false
#      VITE_DEV_RECRUITER_ID=1000000001   # must exist in dev MySQL
#
# 3) Google sign-in through Cognito (new-recruiter registration, approval
#    screen, account lookup). Leave VITE_DEV_RECRUITER_ID BLANK, set
#    VITE_USE_MOCK_API=false and fill in the Cognito values below.
#      VITE_USE_MOCK_API=false
#      VITE_DEV_RECRUITER_ID=
# ---------------------------------------------------------------------------
VITE_USE_MOCK_API=true
VITE_DEV_RECRUITER_ID=

# Amazon Cognito (existing HireMeBot user pool, shared with the Student Portal).
# These are public identifiers, not secrets. Never put a Google client secret here.
VITE_COGNITO_USER_POOL_ID=us-east-2_F582IgoSY
VITE_COGNITO_CLIENT_ID=5rgjoisv64qhe70oulfla17id9
VITE_COGNITO_DOMAIN=us-east-2f582igosy.auth.us-east-2.amazoncognito.com

# Must match, character for character, a callback URL and a sign-out URL that
# are registered on the Cognito app client. Today only these two are:
VITE_COGNITO_REDIRECT_URL=http://localhost:5173/auth/callback
VITE_COGNITO_SIGNOUT_URL=http://localhost:5173/

# Optional: link to the recruiter Terms and Conditions shown on the registration
# form (http/https only). Without it the form shows the label without a link.
VITE_TERMS_URL=
