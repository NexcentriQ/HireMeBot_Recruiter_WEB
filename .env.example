# HireMeBot Recruiter Portal — Environment Example
# Copy this to .env.local for local development.

# Backend API base URL (no trailing slash).
# Local SAM default: http://127.0.0.1:3000
VITE_API_BASE_URL=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# App mode (choose ONE):
#
# 1) Full mock mode — no backend required, in-memory data.
#      VITE_USE_MOCK_API=true
#
# 2) Dev integration mode — real local Java/SAM backend using the
#    ALLOW_DEV_RECRUITER_HEADER mechanism. The frontend sends
#    X-Dev-Recruiter-Id instead of a Cognito Bearer token. Dev-only.
#      VITE_USE_MOCK_API=false
#      VITE_DEV_RECRUITER_ID=1000000001   # must exist in dev MySQL
#
# 3) Production — real Cognito OAuth, real backend. Leave
#    VITE_DEV_RECRUITER_ID blank.
# ---------------------------------------------------------------------------
VITE_USE_MOCK_API=true
VITE_DEV_RECRUITER_ID=

# Amazon Cognito configuration (production).
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/login
